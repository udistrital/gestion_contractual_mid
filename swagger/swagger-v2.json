        "produces": [
          "application/json"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Lista de sedes obtenida exitosamente",
            "schema": {
              "allOf": [
                {
                  "properties": {
                    "Success": {
                      "type": "boolean",
                      "example": true
                    },
                    "Status": {
                      "type": "number",
                      "example": 200
                    },
                    "Message": {
                      "type": "string",
                      "example": "Sedes obtenidas exitosamente"
                    },
                    "Data": {
                      "type": "array",
                      "items": {
                        "properties": {
                          "Id": {
                            "type": "number",
                            "example": 1
                          },
                          "Nombre": {
                            "type": "string",
                            "example": "Sede Principal"
                          }
                        }
                      }
                    }
                  }
                }
              ]
            }
          },
          "404": {
            "description": "",
            "schema": {
              "properties": {
                "Success": {
                  "type": "boolean",
                  "example": false
                },
                "Status": {
                  "type": "number",
                  "example": 404
                },
                "Message": {
                  "type": "string",
                  "example": "No se encontraron sedes activas"
                }
              }
            }
          }
        }
      }
    },
